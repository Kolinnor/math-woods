{
  email {$LETSENCRYPT_EMAIL}
  metrics {
    per_host
  }
}

{$APP_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    X-DNS-Prefetch-Control "off"
    Cross-Origin-Opener-Policy "same-origin"
    Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    -Server
  }

  request_body {
    # The app accepts images up to 5 MiB; leave room for multipart metadata.
    max_size 6MB
  }

  @internalMetrics path /api/internal/metrics
  respond @internalMetrics 404

  reverse_proxy app:3000

  handle_errors 502 503 504 {
    header {
      Cache-Control "no-store"
      Retry-After "60"
    }
    root * /srv
    rewrite * /maintenance.html
    file_server {
      status 503
    }
  }
}

:9180 {
  metrics
}

{$STATUS_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    X-DNS-Prefetch-Control "off"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    -Server
  }

  request_body {
    max_size 1MB
  }

  reverse_proxy uptime-kuma:3001
}
