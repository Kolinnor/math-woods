generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
  OWNER
}

enum ExternalAuthProvider {
  GOOGLE
  ORCID
  GITHUB
}

enum ProblemStatus {
  DRAFT
  PUBLISHED
  FLAGGED
  ARCHIVED
}

enum MathDomain {
  ANALYSIS
  ALGEBRA
  ARITHMETIC
  GEOMETRY
  COMBINATORICS
  PROBABILITY
  TOPOLOGY
  LOGIC
  OTHER
}

enum QualityStatus {
  UNREVIEWED
  REVIEWED
  NEEDS_WORK
}

enum ConceptStatus {
  MISSING
  STUB
  USABLE
  REVIEWED
  EXCELLENT
  CONTROVERSIAL
}

enum ConceptKind {
  DEFINITION
  THEOREM
  INTUITIVE_NOTION
  NOTATION
}

enum ConceptMergeKind {
  TRANSLATION_LINK
  DUPLICATE
}

enum ConceptMergeStatus {
  PENDING
  COMPLETED
  REJECTED
  INVALIDATED
}

enum SourceType {
  PROBLEM
  CONCEPT
  PLAYLIST
  PROOF
}

enum TargetType {
  PROBLEM
  CONCEPT
  PLAYLIST
  POST
  PROOF
  UNKNOWN
}

enum AttemptStatus {
  STARTED
  BLOCKED
  SOLVED
  REVIEW_LATER
}

enum ProblemDifficultyReaction {
  TOO_HARD
  TOO_EASY
  FEELS_RIGHT
}

enum ProblemPreferenceReaction {
  MORE_LIKE_THIS
  LESS_LIKE_THIS
}

enum ProblemRecommendationDismissalReason {
  TOO_HARD
  TOO_EASY
  LESS_LIKE_THIS
  ALREADY_KNOWN
  NOT_INTERESTED_IN_DOMAIN
}

enum RecommendationEventType {
  OPENED
  STARTED
  SOLVED
  BLOCKED
  TOO_HARD
  TOO_EASY
}

enum ProblemStyle {
  PROOF
  CALCULATION
  CONSTRUCTION
  COUNTEREXAMPLE
  CLASSIFICATION
  OPTIMIZATION
  VISUAL
  ALGORITHMIC
  PUZZLE
  TRICK_QUESTION
  MULTIPLE_APPROACHES
}

enum PostType {
  COMMENT
  HINT
  SOLUTION
  GENERALIZATION
  CORRECTION
}

enum VoteType {
  UP
  DOWN
  ELEGANT
  PEDAGOGICAL
  ORIGINAL
  USEFUL_HINT
}

enum PlaylistVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum PlaylistNodeKind {
  PROBLEM
  CONCEPT
  NOTE
}

enum ExplorationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ExplorationCollaboratorRole {
  EDITOR
  REVIEWER
}

enum ExplorationBlockKind {
  MARKDOWN
  HEADING
  DEFINITION
  THEOREM
  LEMMA
  PROPOSITION
  COROLLARY
  PROOF
  EXAMPLE
  COUNTEREXAMPLE
  REMARK
  CALLOUT
  IMAGE
  DIVIDER
  PROBLEM
  CONCEPT
  QUIZ
  CHOICE
}

enum ExplorationQuizType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_TEXT
  NUMBER
}

enum ExplorationOutcomeKind {
  ANSWER
  CORRECT
  INCORRECT
  COMBINATION
}

enum ExplorationOptionAction {
  STAY
  PAGE
  REVEAL
}

enum ExplorationSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum ReportCategory {
  MATHEMATICAL_ERROR
  INCOMPLETE_ARGUMENT
  UNCLEAR_EXPLANATION
  IRRELEVANT_OR_ABUSIVE
  OTHER
}

enum SuggestionStatus {
  OPEN
  PLANNED
  CLOSED
}

enum ContributionRequestKind {
  PROBLEM
  CONCEPT
}

enum ContributionRequestStatus {
  OPEN
  CLAIMED
  COMPLETED
}

enum SiteImprovementStatus {
  BACKLOG
  LONG_TERM
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum SiteImprovementPriority {
  LOW
  NORMAL
  HIGH
}

enum SiteImprovementActivityType {
  CREATED
  DETAILS_CHANGED
  STATUS_CHANGED
  PRIORITY_CHANGED
}

enum SiteImprovementCompletionReviewStatus {
  PENDING
  CONFIRMED
  FOLLOW_UP
  INVALIDATED
}

enum NotificationType {
  PROBLEM_ATTEMPTED
  PROBLEM_SOLVED
  PROBLEM_EDITED
  PROBLEM_EDIT_PROPOSED
  PROBLEM_EDIT_APPROVED
  PROBLEM_EDIT_REJECTED
  CONCEPT_EDIT_PROPOSED
  CONCEPT_EDIT_APPROVED
  CONCEPT_EDIT_REJECTED
  PROOF_ADDED
  SOLUTION_VOTED
  SOLUTION_REPORTED
  DISCUSSION_POSTED
  ACHIEVEMENT_UNLOCKED
  VERIFICATION_REQUESTED
  VERIFICATION_MESSAGE
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  SITE_ERROR_REPORTED
  USER_REGISTERED
  PROBLEM_CREATED
  PROBLEM_DELETED
  PROBLEM_ATTRIBUTION_TRANSFERRED
  CONCEPT_CREATED
  CONCEPT_EDITED
  CONTRIBUTION_REQUEST_CLAIMED
  CONTRIBUTION_REQUEST_REMINDER
  FRIEND_REQUEST
  CHAT_MESSAGE
  PROBLEM_CHALLENGE
  PROBLEM_SHARED
  CONCEPT_SHARED
  PROBLEM_OF_THE_DAY
  EXPLORATION_PUBLISHED
  DAILY_CONCEPT_REVIEW
  CONTEST_UPDATE
  TRUSTED_USER_CANDIDATE
  TRUSTED_USER_PROMOTED
  SITE_IMPROVEMENT_COMPLETED
}

enum TrustedUserRecommendationStatus {
  PENDING
  APPROVED
  DECLINED
  INVALIDATED
}

enum ContestPlacement {
  WINNER
  HONORABLE_MENTION
}

enum ProblemEditProposalStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ProblemVerificationMode {
  NONE
  SELF_CHECK
  AUTHOR_REVIEW
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ProblemVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserMathLevel {
  BEGINNER_PRE_UNIVERSITY
  EARLY_UNDERGRAD
  UNDERGRAD
  ADVANCED_UNDERGRAD
  GRADUATE_CONTEST
  RESEARCH
}

model User {
  id                              Int                             @id @default(autoincrement())
  // A migration also maintains a case-insensitive unique index on this field.
  username                        String                          @unique
  // Public profile URL, kept separate from login identifiers and OAuth data.
  profileSlug                     String                          @unique
  // A migration maintains case-insensitive uniqueness for active public names.
  displayName                     String?
  displayNameUniquenessExempt     Boolean                         @default(false)
  displayNameChangedAt            DateTime?
  avatarUrl                       String?
  avatarBackground                String?
  email                           String?                         @unique
  emailVerifiedAt                 DateTime?
  passwordHash                    String?
  bio                             String?
  discoverySource                 String?
  discoverySourceDetail           String?
  affiliation                     String?
  websiteUrl                      String?
  mathematicalDomains             MathDomain[]                    @default([])
  openToCollaboration             Boolean                         @default(false)
  mathLevel                       UserMathLevel?
  reputation                      Int                             @default(0)
  role                            Role                            @default(USER)
  createdAt                       DateTime                        @default(now())
  updatedAt                       DateTime                        @updatedAt
  deletedAt                       DateTime?
  lastSeenAnnouncementAt          DateTime?
  problems                        Problem[]
  problemAttributionsFrom         ProblemAttributionTransfer[]    @relation("ProblemAttributionFrom")
  problemAttributionsTo           ProblemAttributionTransfer[]    @relation("ProblemAttributionTo")
  problemAttributionsTransferred  ProblemAttributionTransfer[]    @relation("ProblemAttributionActor")
  conceptsCreated                 Concept[]                       @relation("ConceptCreatedBy")
  conceptsEdited                  Concept[]                       @relation("ConceptLastEditedBy")
  revisions                       PageRevision[]
  conceptTalkPosts                ConceptTalkPost[]
  attempts                        ProblemAttempt[]
  recommendationExposures         ProblemRecommendationExposure[]
  recommendationEvents            RecommendationEvent[]
  problemDifficultyVotes          ProblemDifficultyVote[]
  problemReactions                ProblemReaction[]
  posts                           DiscussionPost[]
  playlists                       Playlist[]
  votes                           Vote[]
  reports                         Report[]                        @relation("ReportReporter")
  reportsReviewed                 Report[]                        @relation("ReportReviewer")
  sessions                        Session[]
  externalIdentities              ExternalIdentity[]
  oauthLinkAttempts               OAuthAttempt[]                  @relation("OAuthAttemptLinkUser")
  emailVerificationTokens         EmailVerificationToken[]
  favorites                       ProblemFavorite[]
  problemHints                    ProblemHint[]
  problemHintTranslations         ProblemHint[]                   @relation("ProblemHintTranslator")
  proofs                          ProblemProof[]
  proofTranslations               ProblemProof[]                  @relation("ProblemProofTranslator")
  proofComments                   ProofComment[]
  suggestions                     Suggestion[]
  playlistFollows                 PlaylistFollow[]
  quotes                          Quote[]
  notifications                   Notification[]                  @relation("NotificationRecipient")
  notificationsSent               Notification[]                  @relation("NotificationActor")
  notificationPreferences         NotificationPreference[]
  siteAnnouncementsCreated        SiteAnnouncement[]              @relation("SiteAnnouncementCreator")
  siteAnnouncementRecipients      SiteAnnouncementRecipient[]
  announcementsCreated            Announcement[]                  @relation("AnnouncementAuthor")
  conceptMergeProposalsCreated    ConceptMergeProposal[]          @relation("ConceptMergeProposer")
  conceptMergeProposalsReviewed   ConceptMergeProposal[]          @relation("ConceptMergeReviewer")
  conceptMergeCredits             ConceptMergeContributor[]
  conceptRedirectsCreated         ConceptRedirect[]               @relation("ConceptRedirectCreator")
  achievementUnlocks              AchievementUnlock[]
  latexPreference                 LatexPreference?
  errorReports                    ErrorReport[]
  verificationRequests            ProblemVerificationRequest[]    @relation("ProblemVerificationRequester")
  reviewedVerificationRequests    ProblemVerificationRequest[]    @relation("ProblemVerificationReviewer")
  verificationMessages            ProblemVerificationMessage[]
  friendRequestsSent              Friendship[]                    @relation("FriendshipRequester")
  friendRequestsReceived          Friendship[]                    @relation("FriendshipAddressee")
  directChatsAsA                  DirectChat[]                    @relation("DirectChatUserA")
  directChatsAsB                  DirectChat[]                    @relation("DirectChatUserB")
  chatMessages                    ChatMessage[]
  chatMessageReactions            ChatMessageReaction[]
  problemChallengesSent           ProblemChallenge[]              @relation("ProblemChallengeChallenger")
  problemChallengesReceived       ProblemChallenge[]              @relation("ProblemChallengeRecipient")
  problemChallengeInvitesSent     ProblemChallengeInvite[]        @relation("ProblemChallengeInviteChallenger")
  problemChallengeInvitesAccepted ProblemChallengeInvite[]        @relation("ProblemChallengeInviteAcceptedBy")
  contributionRequestsCreated     ContributionRequest[]           @relation("ContributionRequestRequester")
  contributionRequestsClaimed     ContributionRequest[]           @relation("ContributionRequestClaimedBy")
  siteImprovementsCreated         SiteImprovement[]               @relation("SiteImprovementCreator")
  siteImprovementComments         SiteImprovementComment[]
  siteImprovementActivities       SiteImprovementActivity[]
  explorationCollaborations       ExplorationCollaborator[]
  explorationEditionsPublished    ExplorationEdition[]            @relation("ExplorationEditionPublisher")
  explorationSessions             ExplorationSession[]
  mathematiciansCreated           Mathematician[]                 @relation("MathematicianCreatedBy")
  dailyConceptReviews             DailyConceptReview[]
  problemEditProposals            ProblemEditProposal[]           @relation("ProblemEditProposalAuthor")
  reviewedProblemEditProposals    ProblemEditProposal[]           @relation("ProblemEditProposalReviewer")
  conceptEditProposals            ConceptEditProposal[]           @relation("ConceptEditProposalAuthor")
  reviewedConceptEditProposals    ConceptEditProposal[]           @relation("ConceptEditProposalReviewer")
  contestsCreated                 ProblemContest[]                @relation("ProblemContestCreator")
  contestSubmissions              ProblemContestSubmission[]
  trustedUserRecommendation       TrustedUserRecommendation?      @relation("TrustedUserRecommendationCandidate")
  trustedRecommendationsDecided   TrustedUserRecommendation[]     @relation("TrustedUserRecommendationDecider")
  displayNameChanges              DisplayNameChange[]             @relation("DisplayNameChangeUser")
  displayNameChangesMade          DisplayNameChange[]             @relation("DisplayNameChangeActor")
}

model DisplayNameChange {
  id             Int      @id @default(autoincrement())
  userId         Int
  actorId        Int
  oldDisplayName String
  newDisplayName String
  changedAt      DateTime @default(now())
  user           User     @relation("DisplayNameChangeUser", fields: [userId], references: [id], onDelete: Cascade)
  actor          User     @relation("DisplayNameChangeActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, changedAt])
  @@index([changedAt])
}

model ExternalIdentity {
  id                Int                  @id @default(autoincrement())
  userId            Int
  provider          ExternalAuthProvider
  providerAccountId String
  providerEmail     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model OAuthAttempt {
  id                    Int                  @id @default(autoincrement())
  tokenHash             String               @unique
  provider              ExternalAuthProvider
  codeVerifier          String
  state                 String
  nonce                 String
  returnTo              String
  linkUserId            Int?
  providerAccountId     String?
  providerEmail         String?
  providerEmailVerified Boolean              @default(false)
  providerDisplayName   String?
  expiresAt             DateTime
  createdAt             DateTime             @default(now())
  linkUser              User?                @relation("OAuthAttemptLinkUser", fields: [linkUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([linkUserId])
}

model Mathematician {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  name            String
  lifespan        String
  birthPlace      String
  portraitUrl     String?
  contentMarkdown String   @default("")
  contentHtml     String   @default("")
  createdById     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User?    @relation("MathematicianCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([name])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userId     Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Friendship {
  id           Int              @id @default(autoincrement())
  requesterId  Int
  addresseeId  Int
  status       FriendshipStatus @default(PENDING)
  introMessage String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  requester    User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee    User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status, updatedAt])
  @@index([requesterId, status, updatedAt])
}

model DirectChat {
  id           Int           @id @default(autoincrement())
  userAId      Int
  userBId      Int
  userACleared DateTime?
  userBCleared DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userA        User          @relation("DirectChatUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User          @relation("DirectChatUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@unique([userAId, userBId])
  @@index([userBId])
  @@index([updatedAt])
}

model ChatMessage {
  id           Int                   @id @default(autoincrement())
  directChatId Int
  authorId     Int
  replyToId    Int?
  bodyMarkdown String
  bodyHtml     String
  imageKey     String?
  imageWidth   Int?
  imageHeight  Int?
  imageBytes   Int?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  editedAt     DateTime?
  deletedAt    DateTime?
  directChat   DirectChat            @relation(fields: [directChatId], references: [id], onDelete: Cascade)
  author       User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo      ChatMessage?          @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      ChatMessage[]         @relation("ChatMessageReplies")
  reactions    ChatMessageReaction[]

  @@index([directChatId, createdAt])
  @@index([authorId, createdAt])
  @@index([replyToId])
}

enum ChatReactionType {
  LIKE
  HEART
  DISLIKE
  SMILE
  LAUGH
  SURPRISE
  SAD
  THINKING
  CELEBRATE
  AGREE
}

enum TipKind {
  TIP
  METHOD
}

model ChatMessageReaction {
  id        Int              @id @default(autoincrement())
  messageId Int
  userId    Int
  reaction  ChatReactionType
  createdAt DateTime         @default(now())
  message   ChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, reaction])
  @@index([messageId, createdAt])
  @@index([userId, createdAt])
}

model Problem {
  id                       Int                             @id @default(autoincrement())
  version                  Int                             @default(1)
  slug                     String                          @unique
  language                 String                          @default("en")
  translationGroupId       String                          @default(cuid())
  translatedFromProblemId  Int?
  translatedFromRevisionId Int?
  title                    String
  bodyMarkdown             String
  bodyHtml                 String
  authorId                 Int
  difficulty               Int?
  editorialDifficulty      Int?
  domain                   MathDomain                      @default(OTHER)
  origin                   String                          @default("Unknown")
  originChapter            String?
  originPage               String?
  originNote               String?
  knownSourceId            Int?
  license                  String                          @default("CC BY-SA 4.0")
  listed                   Boolean                         @default(true)
  isExercise               Boolean                         @default(false)
  isConjecture             Boolean                         @default(false)
  styles                   ProblemStyle[]                  @default([])
  showRelatedProblems      Boolean                         @default(true)
  canAppearOnFrontPage     Boolean                         @default(false)
  status                   ProblemStatus                   @default(PUBLISHED)
  qualityStatus            QualityStatus                   @default(UNREVIEWED)
  needsReviewAfterEdit     Boolean                         @default(false)
  verificationMode         ProblemVerificationMode         @default(NONE)
  verificationPrompt       String?
  verificationAnswer       String?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  author                   User                            @relation(fields: [authorId], references: [id])
  attributionTransfers     ProblemAttributionTransfer[]
  knownSource              KnownProblemSource?             @relation(fields: [knownSourceId], references: [id], onDelete: SetNull)
  thread                   DiscussionThread?
  attempts                 ProblemAttempt[]
  recommendationExposures  ProblemRecommendationExposure[]
  recommendationEvents     RecommendationEvent[]
  reactions                ProblemReaction[]
  playlistItems            PlaylistItem[]
  tags                     ProblemTag[]
  spoilerTags              ProblemSpoilerTag[]
  domains                  ProblemDomain[]
  favorites                ProblemFavorite[]
  hints                    ProblemHint[]
  proofs                   ProblemProof[]
  circuitNodes             PlaylistNode[]
  explorationBlocks        ExplorationBlock[]
  explorationProblemLinks  ExplorationBlockProblem[]
  quoteLinks               QuoteProblem[]
  relatedGroups            ProblemRelationGroup[]          @relation("ProblemRelationSource")
  incomingRelations        ProblemRelation[]               @relation("ProblemRelationTarget")
  verificationRequests     ProblemVerificationRequest[]
  tipLinks                 TipProblem[]
  dailyProblemSchedules    DailyProblemSchedule[]
  conceptExerciseLinks     ConceptExercise[]
  challenges               ProblemChallenge[]
  challengeInvites         ProblemChallengeInvite[]
  editProposals            ProblemEditProposal[]
  contestSubmissions       ProblemContestSubmission[]
  translatedFromProblem    Problem?                        @relation("ProblemTranslationSource", fields: [translatedFromProblemId], references: [id], onDelete: SetNull)
  derivedTranslations      Problem[]                       @relation("ProblemTranslationSource")

  @@unique([translationGroupId, language])
  @@index([status, createdAt])
  @@index([isExercise, status, createdAt])
  @@index([language, status, createdAt])
  @@index([translationGroupId])
  @@index([translatedFromProblemId])
  @@index([knownSourceId])
}

model ProblemAttributionTransfer {
  id                       Int      @id @default(autoincrement())
  problemId                Int
  fromUserId               Int?
  toUserId                 Int?
  transferredById          Int?
  fromDisplayName          String
  toDisplayName            String
  transferredByDisplayName String
  reason                   String?  @db.Text
  createdAt                DateTime @default(now())
  problem                  Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  fromUser                 User?    @relation("ProblemAttributionFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser                   User?    @relation("ProblemAttributionTo", fields: [toUserId], references: [id], onDelete: SetNull)
  transferredBy            User?    @relation("ProblemAttributionActor", fields: [transferredById], references: [id], onDelete: SetNull)

  @@index([problemId, createdAt])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([transferredById])
}

model KnownProblemSource {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  iconUrl   String?
  iconSize  Int       @default(40)
  aliases   String[]  @default([])
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  problems  Problem[]

  @@index([active, name])
}

model ProblemContest {
  id                       Int                        @id @default(autoincrement())
  slug                     String                     @unique
  startDateKey             String                     @unique @db.VarChar(10)
  endDateKey               String                     @db.VarChar(10)
  titleEn                  String
  titleFr                  String
  summaryEn                String
  summaryFr                String
  bodyEn                   String                     @db.Text
  bodyFr                   String                     @db.Text
  rulesEn                  String                     @db.Text
  rulesFr                  String                     @db.Text
  criteriaEn               String                     @db.Text
  criteriaFr               String                     @db.Text
  imageUrl                 String?
  imagePositionX           Int                        @default(50)
  imagePositionY           Int                        @default(50)
  rewardPoints             Int                        @default(300)
  publishedAt              DateTime?
  resultsPublishedAt       DateTime?
  launchNotificationSentAt DateTime?
  deadlineReminderSentAt   DateTime?
  createdById              Int
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  createdBy                User                       @relation("ProblemContestCreator", fields: [createdById], references: [id])
  submissions              ProblemContestSubmission[]

  @@index([publishedAt, startDateKey, endDateKey])
}

model ProblemContestSubmission {
  id                 Int               @id @default(autoincrement())
  contestId          Int
  userId             Int
  problemId          Int
  translationGroupId String
  placement          ContestPlacement?
  submittedAt        DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  contest            ProblemContest    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem            Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@unique([contestId, translationGroupId])
  @@index([contestId, placement, submittedAt])
  @@index([userId, submittedAt])
}

model ProblemEditProposal {
  id           Int                       @id @default(autoincrement())
  problemId    Int
  proposerId   Int
  baseVersion  Int
  snapshot     Json
  editSummary  String?
  status       ProblemEditProposalStatus @default(PENDING)
  reviewedById Int?
  reviewNote   String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  reviewedAt   DateTime?
  problem      Problem                   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  proposer     User                      @relation("ProblemEditProposalAuthor", fields: [proposerId], references: [id], onDelete: Cascade)
  reviewedBy   User?                     @relation("ProblemEditProposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([problemId, status, createdAt])
  @@index([proposerId, status, createdAt])
}

model ProblemChallenge {
  id           Int      @id @default(autoincrement())
  challengerId Int
  recipientId  Int
  problemId    Int
  message      String?
  createdAt    DateTime @default(now())
  challenger   User     @relation("ProblemChallengeChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  recipient    User     @relation("ProblemChallengeRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  problem      Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([challengerId, createdAt])
  @@index([problemId])
}

model ProblemChallengeInvite {
  id           Int       @id @default(autoincrement())
  tokenHash    String    @unique
  challengerId Int
  problemId    Int
  message      String?
  expiresAt    DateTime
  acceptedById Int?
  acceptedAt   DateTime?
