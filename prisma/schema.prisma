  id           Int                        @id @default(autoincrement())
  blockId      Int
  kind         ExplorationOutcomeKind
  label        String
  toPageId     Int?
  toBlockId    Int?
  targetHandle String?
  position     Int
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  block        ExplorationBlock           @relation(fields: [blockId], references: [id], onDelete: Cascade)
  toPage       ExplorationPage?           @relation("ExplorationOutcomeTarget", fields: [toPageId], references: [id], onDelete: SetNull)
  toBlock      ExplorationBlock?          @relation("ExplorationOutcomeBlockTarget", fields: [toBlockId], references: [id], onDelete: SetNull)
  matches      ExplorationOutcomeOption[]

  @@index([blockId, position])
  @@index([toPageId])
  @@index([toBlockId])
}

model ExplorationOutcomeOption {
  outcomeId Int
  optionId  Int
  outcome   ExplorationBlockOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  option    ExplorationBlockOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([outcomeId, optionId])
  @@index([optionId])
}

model ExplorationCollaborator {
  playlistId Int
  userId     Int
  role       ExplorationCollaboratorRole @default(EDITOR)
  createdAt  DateTime                    @default(now())
  playlist   Playlist                    @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([playlistId, userId])
  @@index([userId])
}

model ExplorationEdition {
  id            Int                  @id @default(autoincrement())
  playlistId    Int
  version       Int
  snapshot      Json
  changeSummary String?
  publishedById Int?
  publishedAt   DateTime             @default(now())
  playlist      Playlist             @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  publishedBy   User?                @relation("ExplorationEditionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  sessions      ExplorationSession[]

  @@unique([playlistId, version])
  @@index([playlistId, publishedAt])
}

model ExplorationSession {
  id               Int                      @id @default(autoincrement())
  playlistId       Int
  userId           Int
  editionId        Int?
  currentPageId    Int?
  currentPageKey   String?
  currentBlockKey  String?
  state            Json                     @default("{}")
  visitedPageIds   Json                     @default("[]")
  visitedPageKeys  Json                     @default("[]")
  visitedBlockKeys Json                     @default("[]")
  pathBlockKeys    Json                     @default("[]")
  status           ExplorationSessionStatus @default(IN_PROGRESS)
  score            Int                      @default(0)
  maxScore         Int                      @default(0)
  startedAt        DateTime                 @default(now())
  lastSeenAt       DateTime                 @updatedAt
  completedAt      DateTime?
  playlist         Playlist                 @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition          ExplorationEdition?      @relation(fields: [editionId], references: [id], onDelete: SetNull)
  currentPage      ExplorationPage?         @relation(fields: [currentPageId], references: [id], onDelete: SetNull)
  answers          ExplorationAnswer[]

  @@unique([playlistId, userId])
  @@index([userId, lastSeenAt])
  @@index([playlistId, status])
}

model ExplorationAnswer {
  id        Int                @id @default(autoincrement())
  sessionId Int
  blockId   Int?
  blockKey  String
  response  Json
  isCorrect Boolean?
  score     Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  session   ExplorationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  block     ExplorationBlock?  @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@unique([sessionId, blockKey])
  @@index([blockKey, isCorrect])
  @@index([blockId])
}

model PlaylistItem {
  id           Int      @id @default(autoincrement())
  playlistId   Int
  problemId    Int
  position     Int
  noteMarkdown String?
  playlist     Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  problem      Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([playlistId, problemId])
  @@index([playlistId, position])
}

model PlaylistFollow {
  userId     Int
  playlistId Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@id([userId, playlistId])
  @@index([playlistId])
}

model PlaylistNode {
  id           Int              @id @default(autoincrement())
  playlistId   Int
  kind         PlaylistNodeKind @default(NOTE)
  problemId    Int?
  conceptId    Int?
  title        String?
  bodyMarkdown String?
  bodyHtml     String?
  position     Int
  isStart      Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  playlist     Playlist         @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  problem      Problem?         @relation(fields: [problemId], references: [id], onDelete: SetNull)
  concept      Concept?         @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  choices      PlaylistChoice[] @relation("ChoiceFrom")
  incoming     PlaylistChoice[] @relation("ChoiceTo")

  @@index([playlistId, position])
  @@index([problemId])
  @@index([conceptId])
}

model PlaylistChoice {
  id         Int          @id @default(autoincrement())
  fromNodeId Int
  toNodeId   Int
  label      String
  note       String?
  position   Int
  createdAt  DateTime     @default(now())
  fromNode   PlaylistNode @relation("ChoiceFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode     PlaylistNode @relation("ChoiceTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([fromNodeId, position])
  @@index([toNodeId])
}

model Quote {
  id                 Int            @id @default(autoincrement())
  slug               String         @unique
  language           String         @default("en")
  translationGroupId String         @default(cuid())
  text               String
  attributedTo       String?
  provenance         String         @default("Unknown")
  provenanceDetails  String?
  noteMarkdown       String?
  noteHtml           String?
  contributorId      Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  contributor        User?          @relation(fields: [contributorId], references: [id], onDelete: SetNull)
  relatedProblems    QuoteProblem[]
  relatedConcepts    QuoteConcept[]

  @@unique([translationGroupId, language])
  @@index([createdAt])
  @@index([attributedTo])
  @@index([language, createdAt])
  @@index([translationGroupId])
}

model QuoteProblem {
  quoteId   Int
  problemId Int
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([quoteId, problemId])
  @@index([problemId])
}

model QuoteConcept {
  quoteId   Int
  conceptId Int
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([quoteId, conceptId])
  @@index([conceptId])
}

model Report {
  id           Int             @id @default(autoincrement())
  reporterId   Int
  reviewerId   Int?
  targetType   TargetType
  targetId     Int
  category     ReportCategory?
  reason       String
  status       ReportStatus    @default(OPEN)
  reviewerNote String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  resolvedAt   DateTime?
  reporter     User            @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer     User?           @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, status])
  @@index([reporterId, targetType, targetId, status])
  @@index([reviewerId])
}

model Suggestion {
  id        Int              @id @default(autoincrement())
  authorId  Int?
  title     String
  body      String
  status    SuggestionStatus @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  author    User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model ContributionRequest {
  id          Int                       @id @default(autoincrement())
  kind        ContributionRequestKind
  status      ContributionRequestStatus @default(OPEN)
  body        String                    @db.Text
  requesterId Int?
  claimedById Int?
  completedAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  requester   User?                     @relation("ContributionRequestRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  claimedBy   User?                     @relation("ContributionRequestClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)

  @@index([kind, status, createdAt])
  @@index([requesterId])
  @@index([claimedById])
}

model SiteImprovement {
  id                  Int                               @id @default(autoincrement())
  title               String
  descriptionMarkdown String                            @db.Text
  descriptionHtml     String                            @db.Text
  status              SiteImprovementStatus             @default(BACKLOG)
  priority            SiteImprovementPriority           @default(NORMAL)
  creatorId           Int?
  completedAt         DateTime?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  creator             User?                             @relation("SiteImprovementCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  comments            SiteImprovementComment[]
  activities          SiteImprovementActivity[]
  completionReviews   SiteImprovementCompletionReview[]

  @@index([status, priority, updatedAt])
  @@index([creatorId])
}

model SiteImprovementComment {
  id            Int             @id @default(autoincrement())
  improvementId Int
  authorId      Int?
  bodyMarkdown  String          @db.Text
  bodyHtml      String          @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  improvement   SiteImprovement @relation(fields: [improvementId], references: [id], onDelete: Cascade)
  author        User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([improvementId, createdAt])
  @@index([authorId])
}

model SiteImprovementActivity {
  id            Int                         @id @default(autoincrement())
  improvementId Int
  actorId       Int?
  type          SiteImprovementActivityType
  fromValue     String?
  toValue       String?
  createdAt     DateTime                    @default(now())
  improvement   SiteImprovement             @relation(fields: [improvementId], references: [id], onDelete: Cascade)
  actor         User?                       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([improvementId, createdAt])
  @@index([actorId])
}

model SiteImprovementCompletionReview {
  id             Int                                   @id @default(autoincrement())
  improvementId  Int
  notificationId Int?                                  @unique
  status         SiteImprovementCompletionReviewStatus @default(PENDING)
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt
  respondedAt    DateTime?
  improvement    SiteImprovement                       @relation(fields: [improvementId], references: [id], onDelete: Cascade)
  notification   Notification?                         @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([improvementId, status, createdAt])
}

model FaqSection {
  id        Int       @id @default(autoincrement())
  position  Int       @default(0)
  title     String
  anchorId  String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  items     FaqItem[]

  @@index([position])
}

model FaqItem {
  id             Int        @id @default(autoincrement())
  sectionId      Int
  position       Int        @default(0)
  question       String
  answerMarkdown String     @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  section        FaqSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
}

model ContributionPageContent {
  id             Int      @id
  title          String
  requestEyebrow String
  requestTitle   String
  requestIntro   String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContributionPageSection {
  id           Int      @id @default(autoincrement())
  position     Int      @default(0)
  title        String
  bodyMarkdown String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([position])
}

model RolesPageContent {
  id           Int      @id
  bodyMarkdown String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HomePriorityContent {
  language  String   @id
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tip {
  id                      Int                         @id @default(autoincrement())
  position                Int                         @unique
  title                   String
  description             String
  body                    String                      @db.Text
  imageUrl                String?
  imagePositionX          Int                         @default(50)
  imagePositionY          Int                         @default(50)
  showInMainMenu          Boolean                     @default(false)
  kind                    TipKind                     @default(TIP)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  problems                TipProblem[]
  problemGroups           TipProblemGroup[]
  images                  TipImage[]
  translations            TipTranslation[]
  dailySchedules          DailyTipSchedule[]
  dailyRotationSelections DailyTipRotationSelection[]
}

model TipTranslation {
  id        Int      @id @default(autoincrement())
  tipId     Int
  language  String
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tip       Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@unique([tipId, language])
  @@index([language])
}

model TipImage {
  id             Int      @id @default(autoincrement())
  tipId          Int
  position       Int      @default(0)
  imageUrl       String
  imagePositionX Int      @default(50)
  imagePositionY Int      @default(50)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tip            Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@unique([tipId, position])
  @@index([tipId, position])
}

model TipProblem {
  tipId     Int
  problemId Int
  position  Int     @default(0)
  tip       Tip     @relation(fields: [tipId], references: [id], onDelete: Cascade)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([tipId, problemId])
  @@index([tipId, position])
  @@index([problemId])
}

model TipProblemGroup {
  tipId              Int
  translationGroupId String
  position           Int    @default(0)
  tip                Tip    @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@id([tipId, translationGroupId])
  @@index([tipId, position])
  @@index([translationGroupId])
}

model DailyProblemSchedule {
  dateKey        String   @id @db.VarChar(10)
  problemId      Int
  imageUrl       String?
  imagePositionX Int      @default(50)
  imagePositionY Int      @default(50)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model DailyTipSchedule {
  dateKey   String   @id @db.VarChar(10)
  tipId     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tip       Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@index([tipId])
}

model DailyTipRotationSelection {
  dateKey   String   @id @db.VarChar(10)
  tipId     Int
  createdAt DateTime @default(now())
  tip       Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@index([tipId])
}

model Notification {
  id                    Int                              @id @default(autoincrement())
  userId                Int
  actorId               Int?
  type                  NotificationType
  aggregationKey        String?
  title                 String
  body                  String
  href                  String
  readAt                DateTime?
  dismissedFromMenuAt   DateTime?
  createdAt             DateTime                         @default(now())
  user                  User                             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor                 User?                            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  dailyConceptReview    DailyConceptReview?
  trustedUserReview     TrustedUserRecommendation?
  siteImprovementReview SiteImprovementCompletionReview?

  @@unique([userId, type, aggregationKey])
  @@index([userId, readAt, createdAt])
  @@index([actorId])
}

model SiteAnnouncement {
  id            Int                         @id @default(autoincrement())
  title         String
  bodyMarkdown  String
  bodyHtml      String
  audienceRoles Role[]
  createdById   Int?
  createdAt     DateTime                    @default(now())
  cancelledAt   DateTime?
  createdBy     User?                       @relation("SiteAnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recipients    SiteAnnouncementRecipient[]

  @@index([createdAt])
  @@index([cancelledAt, createdAt])
}

model SiteAnnouncementRecipient {
  announcementId Int
  userId         Int
  acknowledgedAt DateTime?
  createdAt      DateTime         @default(now())
  announcement   SiteAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId, acknowledgedAt, createdAt])
}

model Announcement {
  id           Int      @id @default(autoincrement())
  title        String
  bodyMarkdown String
  bodyHtml     String
  createdById  Int?
  createdAt    DateTime @default(now())
  createdBy    User?    @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model TrustedUserRecommendation {
  id             Int                             @id @default(autoincrement())
  userId         Int                             @unique
  notificationId Int?                            @unique
  decidedById    Int?
  reputation     Int
  threshold      Int
  status         TrustedUserRecommendationStatus @default(PENDING)
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  decidedAt      DateTime?
  user           User                            @relation("TrustedUserRecommendationCandidate", fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification?                   @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  decidedBy      User?                           @relation("TrustedUserRecommendationDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([decidedById])
}

model DailyConceptReview {
  id             Int           @id @default(autoincrement())
  userId         Int
  conceptId      Int
  notificationId Int?          @unique
  assignedStatus ConceptStatus
  createdAt      DateTime      @default(now())
  completedAt    DateTime?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept        Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([userId, completedAt, createdAt])
  @@index([conceptId, completedAt])
}

model NotificationPreference {
  userId    Int
  type      NotificationType
  enabled   Boolean          @default(true)
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

model AchievementUnlock {
  id          Int      @id @default(autoincrement())
  userId      Int
  key         String
  title       String
  description String
  unlockedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, unlockedAt])
}

model ErrorReport {
  id           Int       @id @default(autoincrement())
  message      String    @db.Text
  stack        String?   @db.Text
  digest       String?
  path         String
  source       String    @default("client")
  userAgent    String?   @db.Text
  userId       Int?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewerNote String?   @db.Text
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([reviewedAt, createdAt])
  @@index([userId, createdAt])
}

model LatexPreference {
  userId                   Int      @id
  autocloseDollars         Boolean  @default(true)
  mathShortcuts            Boolean  @default(true)
  moveCursorBetweenDollars Boolean  @default(true)
  encloseSelectionDollars  Boolean  @default(true)
  autocloseCurlyBrackets   Boolean  @default(false)
  autocloseSquareBrackets  Boolean  @default(false)
  autocloseRoundBrackets   Boolean  @default(false)
  appendSumLimits          Boolean  @default(true)
  autoEnlargeBrackets      Boolean  @default(true)
  superscriptBraces        Boolean  @default(true)
  subscriptBraces          Boolean  @default(true)
  slashFractions           Boolean  @default(false)
  alignShortcut            Boolean  @default(true)
  alignEnvironment         String   @default("align*")
  autoAlignSymbols         String   @default("= > < \\le \\ge \\neq \\approx")
  casesShortcut            Boolean  @default(true)
  shiftEnterLineBreaks     Boolean  @default(false)
  matrixShortcut           Boolean  @default(true)
  matrixEnvironment        String   @default("pmatrix")
  greekMathMode            Boolean  @default(true)
  customShorthand          Boolean  @default(true)
  tabCompletesShorthand    Boolean  @default(false)
  customCommands           String   @db.Text
  markdownHeadingShortcuts Boolean  @default(true)
  markdownHeading1Shortcut String   @default("Ctrl+1")
  markdownHeading2Shortcut String   @default("Ctrl+2")
  markdownHeading3Shortcut String   @default("Ctrl+3")
  markdownHeading4Shortcut String   @default("Ctrl+4")
  markdownHeading5Shortcut String   @default("Ctrl+5")
  markdownHeading6Shortcut String   @default("Ctrl+6")
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
